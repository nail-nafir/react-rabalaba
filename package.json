{
  "name": "react-rabalaba",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "wrangler": "wrangler pages dev --port 8888 -- vite --host",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "gate:compare": "node scripts/gate-compare.mjs",
    "build:edge": "esbuild src/core/edge-engine.ts --bundle --format=esm --platform=neutral --alias:@=./src --outfile=supabase/functions/auto-journal/_engine.mjs && esbuild src/core/edge-engine.ts --bundle --format=esm --platform=neutral --alias:@=./src --outfile=supabase/functions/daily-summary/_engine.mjs && esbuild src/core/edge-engine.ts --bundle --format=esm --platform=neutral --alias:@=./src --outfile=supabase/functions/asset-discovery/_engine.mjs",
    "deploy:auto-journal": "npm run build:edge && npx supabase functions deploy auto-journal --project-ref nravncsodgcxwkdaeqcw",
    "deploy:daily-summary": "npm run build:edge && npx supabase functions deploy daily-summary --project-ref nravncsodgcxwkdaeqcw",
    "deploy:asset-discovery": "npm run build:edge && npx supabase functions deploy asset-discovery --project-ref nravncsodgcxwkdaeqcw",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@reduxjs/toolkit": "^2.13.0",
    "@shadcn/react": "^0.3.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^9.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "i18next": "^26.4.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.55.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.16",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "shadcn": "^4.21.4",
    "supabase": "2.120.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
